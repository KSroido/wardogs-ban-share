{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wardogs-ban-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "wardogs.ksroido.art/api/ban-share",
      "zone_name": "ksroido.art"
    },
    {
      "pattern": "wardogs.ksroido.art/api/ban-share/*",
      "zone_name": "ksroido.art"
    },
    // 用通配符：这个 zone 上还有 anticheat 的 custom domain，精确 pattern 带 query
    // 时会落到那个 Worker（实测 /ban-share?token=… → 404）。通配符不受影响。
    {
      "pattern": "wardogs.ksroido.art/ban-share*",
      "zone_name": "ksroido.art"
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "kv_namespaces": [
    { "binding": "GUARD", "id": "ae627c467a694af0a0bef3b97b96d58c" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wardogs_bans",
      "database_id": "766a8fa8-97d6-4724-8e8a-1a050252fa06",
      "migrations_dir": "migrations"
    }
  ]
}
